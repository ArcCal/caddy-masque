[Unit]
Description=Caddy with the MASQUE CONNECT-IP VPN
Documentation=https://github.com/ArcCal/caddy-masque
After=network-online.target
Wants=network-online.target
# Keep retrying, for example while the network is still coming up at boot.
StartLimitIntervalSec=0

[Service]
Type=notify
# Runs as root, because the masque app writes sysctls under /proc/sys; the
# rest of the root user's powers are taken away below. What it keeps:
# CAP_NET_ADMIN (the TUN device, addresses, nftables, connection tracking,
# sysctls), CAP_NET_BIND_SERVICE (ports 80 and 443) and CAP_DAC_READ_SEARCH
# (reading site and certificate files owned by other users).
ExecStart=/usr/local/bin/caddy run --config /etc/caddy/Caddyfile
# Applies a changed Caddyfile (users, blocked destinations, sites) without
# dropping tunnels; --force also re-reads certificate files that changed.
ExecReload=/usr/local/bin/caddy reload --config /etc/caddy/Caddyfile --force
# Caddy's certificates and state in /var/lib/caddy, its autosaved
# configuration in /var/lib/caddy-config.
Environment=XDG_DATA_HOME=/var/lib XDG_CONFIG_HOME=/var/lib/caddy-config
Environment=HOME=/var/lib/caddy
# Caddy's admin API (configuration, reloads, /metrics) on a socket only root
# can use. Its default, localhost:2019, has no authentication: every local
# user and process could read the configuration, password hashes included,
# load another one or stop the server, which runs as root. ExecReload finds
# the socket through this too. An `admin` option in the Caddyfile overrides it.
Environment="CADDY_ADMIN=unix//run/caddy-masque/admin.sock|0600"
RuntimeDirectory=caddy-masque
RuntimeDirectoryMode=0700
TimeoutStopSec=45s
LimitNOFILE=1048576
Restart=on-failure
RestartSec=5
StateDirectory=caddy caddy-config
LogsDirectory=caddy
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_DAC_READ_SEARCH
# The whole file system is read-only except the state and log directories
# above; a site or log file elsewhere needs ReadWritePaths= (use a drop-in:
# systemctl edit caddy-masque). /proc/sys stays writable on purpose, so there
# is no ProtectKernelTunables= (or ProcSubset=pid).
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
DevicePolicy=closed
DeviceAllow=/dev/net/tun rw
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
