[Unit]
Description=Caddy with the MASQUE CONNECT-IP VPN
Documentation=https://github.com/ArcCal/caddy-masque
After=network-online.target
Wants=network-online.target
# Keep retrying, for example while the network is still coming up at boot.
StartLimitIntervalSec=0

[Service]
Type=notify
User=caddy-masque
Group=caddy-masque
UMask=0077
# CAP_NET_ADMIN permits TUN, routes, nftables, conntrack and network sysctls.
# Ambient capabilities also reach the ip/nft subprocesses. No DAC bypass.
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
ExecStart=/usr/local/bin/caddy run --config /etc/caddy/Caddyfile
# Applies a changed Caddyfile (users, blocked destinations, sites) without
# dropping tunnels; --force also re-reads certificate files that changed.
ExecReload=/usr/local/bin/caddy reload --config /etc/caddy/Caddyfile --force
# Caddy's certificates and state in /var/lib/caddy, its autosaved
# configuration in /var/lib/caddy-config.
Environment=XDG_DATA_HOME=/var/lib XDG_CONFIG_HOME=/var/lib/caddy-config
# Caddy's admin API (configuration, reloads, /metrics) on a socket only the
# service account and root can use. localhost:2019 has no authentication: a local
# user and process could read the configuration, password hashes included,
# load another one or stop the server. ExecReload finds
# the socket through this too. An `admin` option in the Caddyfile overrides it.
Environment="CADDY_ADMIN=unix//run/caddy-masque/admin.sock|0600"
RuntimeDirectory=caddy-masque
RuntimeDirectoryMode=0700
TimeoutStopSec=10s
LimitNOFILE=1048576
Restart=on-failure
RestartSec=5
StateDirectory=caddy caddy-config
StateDirectoryMode=0700
LogsDirectory=caddy
LogsDirectoryMode=0700
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
# The whole file system is read-only except the state and log directories
# above; a site or log file elsewhere needs ReadWritePaths= (use a drop-in:
# systemctl edit caddy-masque). Only network sysctls used by MASQUE are writable;
# conf directories include interface files created after the service starts.
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
PrivateTmp=yes
PrivateDevices=yes
BindPaths=/dev/net/tun
DevicePolicy=closed
DeviceAllow=/dev/net/tun rw
ProtectKernelTunables=yes
ReadWritePaths=/proc/sys/net/ipv4/ip_forward /proc/sys/net/ipv4/conf -/proc/sys/net/ipv6/conf
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
