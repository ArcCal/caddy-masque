[package]
name = "caddy-wrapper-compat"
version = "0.1.0"
edition = "2021"
publish = false

[workspace]

[dependencies]
anyhow = "1"
bytes = "1"
masque-vpn = { path = __MASQUE_CORE_PATH__ }
masque-vpn-mac = { path = __MASQUE_MAC_PATH__ }
masque-vpn-killswitch = { path = __MASQUE_KILLSWITCH_PATH__ }
tokio = { version = "1", features = ["rt-multi-thread", "macros", "net", "time", "sync"] }
tracing = "0.1"
tracing-subscriber = "0.3"

# Cargo only applies patches declared by the top-level workspace. Match the
# current clients' transport fixes rather than silently testing upstream h3.
[patch."https://github.com/hyperium/h3"]
h3 = { path = __MASQUE_H3_PATH__ }
h3-quinn = { path = __MASQUE_H3_QUINN_PATH__ }
