+		pn := h.PopPacketNumber(protocol.Encryption1RTT)
+		h.SentPacket(now, pn, protocol.InvalidPacketNumber, nil, []Frame{{Frame: &wire.PingFrame{}}}, protocol.Encryption1RTT, protocol.ECNNon, size, false, false)
