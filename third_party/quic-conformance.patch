+		func(cid protocol.ConnectionID, frames []ackhandler.Frame, _ protocol.ByteCount, _ protocol.Version) (shortHeaderPacket, *packetBuffer, error) {
+			buf := getPacketBuffer()
+			buf.Data = buf.Data[:1200]
