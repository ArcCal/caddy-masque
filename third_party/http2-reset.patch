+// ResetStream terminates this stream with the specified HTTP/2 error code.
+// It uses the server's frame queue, preserving serialization with other streams.
+func (w *responseWriter) ResetStream(code uint32) error {
+	st := w.rws.stream
+	return st.sc.writeFrameFromHandler(FrameWriteRequest{
+		write:  StreamError{StreamID: st.id, Code: ErrCode(code)},
+		stream: st,
+	})
+}
