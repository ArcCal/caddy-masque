+	require.Equal(t, time.Hour, first.idleTimeout)
+	selected = ConnectionConfig{}
+	open(ConnectionConfig{MaxHeaderBytes: http.DefaultMaxHeaderBytes})
+	require.Equal(t, 3, calls)
